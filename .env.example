# Copy this file to .env and fill in values before running.

# Postgres connection string, e.g. from Railway, Render, Supabase, or your own server
DATABASE_URL=postgres://user:password@host:5432/etriod

# Long random string used to sign login sessions (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_string

# Self-hosted Ollama-compatible inference endpoint. The default is local-only;
# install Ollama yourself and pull the model before starting the app:
#   ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# Stripe subscription billing
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_TEAM_PRICE_ID=price_xxxxxxxx
STRIPE_DISPLAY_AMOUNT=19
STRIPE_DISPLAY_CURRENCY=USD

# Flutterwave recurring Team plan. Amount is in major currency units.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_TEAM_PLAN_ID=
FLUTTERWAVE_TEAM_AMOUNT=
FLUTTERWAVE_CURRENCY=NGN

# Paystack recurring Team plan. Amount is in major currency units.
PAYSTACK_SECRET_KEY=
PAYSTACK_TEAM_PLAN_CODE=
PAYSTACK_TEAM_AMOUNT=
PAYSTACK_CURRENCY=NGN

# SMTP for password-reset and verification emails. If left unset, links are
# logged to the server console instead of emailed — fine for local dev, not
# for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ETriod <no-reply@yourdomain.com>

# Public URL of your deployed frontend, used for return and reset links
APP_URL=http://localhost:5500

# Port the server listens on
PORT=3000

# Max simultaneous DB connections this server instance will open (raise if you
# run multiple server instances behind a load balancer and hit connection limits)
DB_POOL_MAX=10

# Comma-separated list of origins allowed to call this API (your deployed frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500
